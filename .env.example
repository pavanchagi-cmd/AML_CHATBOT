# Copy to .env.local and fill in. Never commit real values.

# Google Gemini (key from Google AI Studio)
GEMINI_API_KEY=
# Chat model id (current stable Gemini Flash model, to be confirmed)
GEMINI_CHAT_MODEL=
# Default: gemini-embedding-001
GEMINI_EMBED_MODEL=
# Default: 768
EMBED_DIM=

# Pinecone
PINECONE_API_KEY=
# Default: aml-compass
PINECONE_INDEX=
# Default: default
PINECONE_NAMESPACE=

# Set by the Vercel Marketplace integrations (Neon Postgres, Vercel Blob)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Passcode for upload, delete and re-index
ADMIN_PASSCODE=

# Retrieval. Defaults: RAG_TOP_K=8, RAG_MIN_SCORE=0.55 (tune in testing)
RAG_TOP_K=
RAG_MIN_SCORE=

# Only for `npm run pinecone:create-index` when the index doesn't exist yet,
# for example PINECONE_CLOUD=aws and PINECONE_REGION=us-east-1
PINECONE_CLOUD=
PINECONE_REGION=
